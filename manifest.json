{
  "manifest_version": 3,
  "name": "Listing Maps",
  "version": "1.2",
  "description": "Shows a small map next to each listing on realestate.com.au and domain.com.au search results.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/listing-maps-icon-16.png",
    "32": "icons/listing-maps-icon-32.png",
    "48": "icons/listing-maps-icon-48.png",
    "128": "icons/listing-maps-icon-128.png"
  },
  "action": {
    "default_title": "Listing map settings",
    "default_popup": "settings-popup.html",
    "default_icon": {
      "16": "icons/listing-maps-icon-16.png",
      "32": "icons/listing-maps-icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.realestate.com.au/*", "https://www.domain.com.au/*"],
      "js": ["map-settings.js", "listing-site-adapters.js", "add-listing-maps.js"],
      "css": ["listing-map.css"]
    }
  ]
}
